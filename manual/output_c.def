subcode:: sections
    $call section, c, $(code:output_c)
    $p
        $(code:output_c) lives in its own repository, $(a:github.com/hzhou/output_c,https://github.com/hzhou/output_c). Install it the same way as MyDef itself -- clone it, then run $(code:mydef_make), $(code:make), and $(code:make install) inside it. It provides $(code:module: c) (and $(code:module: cpp) for C++).
    $p
        C is a lower-level language than Perl. It has more syntax to type -- semicolons, braces, parentheses, format strings, and, above all, type declarations. Much of what $(code:output_c) adds is aimed at that noise, so the code that remains says what the program does.

    $call subsection, c_plain, It is OK to write vanilla C
    $p
        A page with $(code:module: c) compiles to a $(code:.c) file. $(code:basic_frame), defined in $(code:std_c.def), supplies the $(code:main) function and puts the page code inside it. (It is the default frame, so naming it is optional -- see the next section.)
    &call codeprint, mydef
        page: t, basic_frame
            module: c

            int a = 3;
            if (a > 2) {
                printf("a is big\n");
            }
    &call codeprint, sh
        $ mydef_run t.def
        PAGE: t
          --> [./t.c]
        gcc -std=c99 -g -O2 -o ./t ./t.c  && ./t
        a is big
    $p
        and $(code:t.c) is what you would expect:
    &call codeprint, c
        &num;include <stdio.h>
        &num;include <stdlib.h>

        int main(int argc, char** argv)
        {
            int a = 3;
            if (a > 2) {
                printf("a is big\n");
            }
            return 0;
        }
    $p
        As with $(code:output_perl), semicolons are optional, and $(code:$if), $(code:$elif), $(code:$else), and $(code:$while) let you drop the parentheses and braces:
    &call codeprint, mydef
        page: t, basic_frame
            module: c

            $local int a = 3
            $if a > 2
                printf("a is big\n")
            $elif a > 1
                printf("a is medium\n")
            $else
                printf("a is small\n")
            $while a > 0
                a--
    $p
        $(code:output_c) also warns about the classic $(code:=) vs $(code:==) mistake: $(code:$if a = 0) produces the warning $(code:Assignment in [a = 0]&#44; possible bug?). For a $(code:do ... while) loop there is $(code:$dowhile cond).

    $call subsection, c_frame, Scripts, programs, and libraries
    $p
        When a page does not name a frame, $(code:MyDef) uses $(code:basic_frame) if one is defined -- and $(code:std_c.def) defines one. So every C page gets a $(code:main) function by default, and $(code:page: t) means the same as $(code:page: t&#44; basic_frame). The default serves the most common use: quick programs run with $(code:mydef_run).
    $p
        For a one-off script, even the $(code:page:) line is optional. A $(code:.def) file without any $(code:page:) becomes a page named after the file, and its top-level code becomes the body of $(code:main):
    &call codeprint, mydef
        module: c

        $print Hello from a script
        $local int n = 6
        $print n*7 = ${n*7}
    &call codeprint, sh
        $ mydef_run script.def
        PAGE: script
          --> [./script.c]
        gcc -std=c99 -g -O2 -o ./script ./script.c  && ./script
        Hello from a script
        n*7 = 42
    $p
        That makes C about as quick to try out as a scripting language.
    $p
        To write C code without $(code:main) -- a library, or a file to be linked into another program -- give the page the frame $(code:-), which means "no frame". Since nothing calls the functions, tell $(code:output_c) which ones to include, either one by one with $(code:$list) or all at once with $(code:autolist&#58; global):
    &call codeprint, mydef
        page: mylib, -
            module: c
            autolist: global

        fncode: add(a, b: int): int
            return a + b

        fncode: mean(a, b: double): double
            return (a+b)/2
    &call codeprint, c
        int add(int a, int b);
        double mean(double a, double b);

        int add(int a, int b)
        {
            return a + b;
        }

        double mean(double a, double b)
        {
            return (a + b) / 2;
        }
    $p
        $(code:autolist&#58; page) is similar but includes only the $(code:fncode:) blocks defined inside the page, which is useful when one $(code:.def) file holds several pages. Any page code outside functions goes to the top level of the file.

    $call subsection, c_print, $(code:$print)
    $p
        $(code:$print) is meant for debug printing -- the quick "what is in this variable now" line that we add and remove many times while developing. For that it offers two conveniences: variables are interpolated directly into the text, and the newline is added automatically.
    &call codeprint, mydef
        $local int n = 3
        $local double x = 1.5
        $local char *s_name = "Bob"
        $print n = $n, x = $x, name = $s_name
    $p
        The format for each variable is picked from its type:
    &call codeprint, c
        printf("n = %d, x = %g, name = %s\n", n, x, s_name);
    $p
        A few more forms:
    &call codeprint, mydef
        $print "x = %.2f", x        &num; printf format, newline still added
        $print Loading -            &num; trailing "-": no newline
        $print arr[2] = ${arr[2]}   &num; ${...} for an expression
        $dump n, x                  &num; prints "    :n=3, x=1.5"
    $p
        The two styles can be mixed. In the quoted form, $(code:%) formats take their arguments from the list after the string, and $(code:$var) is filled in where it appears -- handy when one value needs a specific format and the rest do not:
    &call codeprint, mydef
        $print "x = %.2f, n = $n, name = $s_name", x
        $print "[%5d] [$n] [%-6s]", n, s_name
    &call codeprint, c
        printf("x = %.2f, n = %d, name = %s\n", x, n, s_name);
        printf("[%5d] [%d] [%-6s]\n", n, n, s_name);
    $p
        Mixing requires the quotes. Without them, $(code:$print) does not see where the text ends and the arguments begin: $(code:$print x = %.2f&#44; n = $n&#44; x) produces broken C and a $(code:Missing 1 fmt arguments) warning.
    $p
        To print to another stream, set the $(code:print_to) macro, e.g. $(code:&dollar;(set:print_to=stderr)).
    $p
        $(code:$print) relies on knowing the type of what it prints. When it cannot tell -- an expression such as $(code:${2*n}), a function call, or a variable whose declaration $(code:MyDef) did not see -- it warns and falls back to $(code:%d):
    &call codeprint, sh
        [t.def:14] get_var_fmt: unhandled 2*n - , default to %d
    $p
        At that point $(code:$print) is going out of its way. Don't fight it -- write a regular $(code:printf) (or the printf form of $(code:$print)) with an explicit format:
    &call codeprint, mydef
        printf("twice = %d\n", 2*n)
        $print "sqrt = %f", sqrt(r)

    $call subsection, c_for, $(code:$for) and $(code:$foreach)
    $p
        $(code:$for) takes a range $(code:start:end:step). The end is exclusive, and the loop variable is declared in the loop:
    &call codeprint, mydef
        $for 10             &num; i = 0 ... 9
        $for i=0:10         &num; i = 0 ... 9
        $for j=0:10:3       &num; j = 0, 3, 6, 9
        $for k=9:0:-1       &num; k = 9 ... 0
    $p
        which become, for example, $(code:for (int j = 0; j &lt; 10; j += 3)). As in $(code:output_perl), a decreasing range includes both ends: $(code:9&#58;0&#58;-1) counts from 9 down to 0. The convention is not obvious, so when in doubt write the full C form -- it works too:
    &call codeprint, mydef
        $for i=9; i>=0; i--
            $print $i
    $p
        $(code:$foreach) iterates over an array whose size $(code:MyDef) knows, e.g. one created with $(code:$allocate) (see below).

    $call subsection, c_var, Variables and type inference
    $p
        C wants every variable declared with a type, at the top of its scope. In real code, many of those declaration lines carry no information that the name does not already convey: $(code:i) is an int loop counter, $(code:s_name) is a string, $(code:f_scale) is a float. $(code:output_c) lets the names carry the types and writes the declarations for you, so the code stays short and readable.
    $p
        $(code:$local) declares variables at the top of the current function; $(code:$global) declares them at the top of the file; $(code:$my) declares them in the current block. A variable that is assigned without being declared is declared automatically.
    &call codeprint, mydef
        page: t, basic_frame
            module: c

            $local i, n_count, f_scale, s_name, b_done
            $global g_total = 0
            k = 10
            ratio = 0.5
    $p
        generates:
    &call codeprint, c
        ...
        int g_total = 0;

        int main(int argc, char** argv)
        {
            int i;
            int n_count;
            float f_scale;
            char *s_name;
            bool b_done;
            int k;
            float ratio;

            k = 10;
            ratio = 0.5;
            return 0;
        }
    $p
        The type comes from the name first and, failing that, from the assigned value ($(code:0.5) is a $(code:float), $(code:"text") a $(code:char *)). The built-in naming rules include:
    $table ref
        $tr
            $th "Name"
            $th "Type"
        $tr
            $td
                $(code:i j k m n)
            $td "int"
        $tr
            $td
                $(code:f d)
            $td "float / double"
        $tr
            $td
                $(code:c) and $(code:c_...)
            $td "unsigned char"
        $tr
            $td
                $(code:s) and $(code:s_...)
            $td "char *"
        $tr
            $td
                $(code:b_... is_... has_...)
            $td "bool"
        $tr
            $td
                $(code:n_... i_...)
            $td "int"
        $tr
            $td
                $(code:f_... d_...)
            $td "float / double"
        $tr
            $td
                $(code:n4_... u8_... i64_...)
            $td "int32_t / uint64_t / int64_t"
        $tr
            $td
                $(code:size_... time_... file_...)
            $td "size_t / time_t / FILE *"
        $tr
            $td
                $(code:p_...) + a prefix
            $td
                pointer to that type: $(code:pn_list) is $(code:int *)
    $p
        The full rules are in $(code:types.def) in the $(code:MyDef) and $(code:output_c) sources.

    $h4
        Project naming conventions
    $p
        The built-in rules are a starting point. The real value comes when a project settles on its own naming convention and registers it. $(code:$register_name) gives the type of an exact name; $(code:$register_prefix) gives the type of every name that starts with a prefix and an underscore:
    &call codeprint, mydef
        subcode: _autoload
            $register_name(node) struct Node
            $register_prefix(pt) struct Point
            $register_prefix(len) size_t

        page: t, basic_frame
            module: c
            $struct(Point) f_x, f_y
            $struct(Node) n_value, p_next

            $local node, p_node, pt_start, pt_end, len_name
    &call codeprint, c
        struct Node node;
        struct Node *p_node;
        struct Point pt_start;
        struct Point pt_end;
        size_t len_name;
    $p
        $(code:p_node) became a pointer to $(code:node)'s type, following the $(code:p_) rule. Once the convention is registered, code throughout the project stays free of declarations -- and the convention itself is enforced, because a name that breaks it gets the wrong type and the compiler complains.

    $h4
        Explicit types
    $p
        Inference is heuristic. A name that matches no rule, and has no value to infer from, gets no type at all (the declaration comes out as just $(code:foo;)). A variable assigned from a function call may also miss, since the function's return type may not be known yet. Whenever that happens, or whenever you prefer, declare the type explicitly -- any of these forms work:
    &call codeprint, mydef
        $local int count, char grade, double ratio = 0.5
        $local foo: long
        $my a: char[10]
    &call codeprint, c
        int count;
        char grade;
        double ratio = 0.5;
        long foo;
        char a[10];
    $p
        Note that a declaration written as plain C with a semicolon, such as $(code:int a = 3;), is passed through untouched, and $(code:MyDef) does not record its type. Without the semicolon, $(code:double x = 0.5) is recognized, and the declaration is moved to the top of the function.

    $call subsection, c_fn, $(code:fncode) and prototypes
    $p
        $(code:fncode:) defines a C function. Parameter types follow the same naming rules, or can be given explicitly; the return type is inferred from the $(code:return) statement or given after a colon. Prototypes are generated at the top of the file, so functions can be defined in any order:
    &call codeprint, mydef
        page: t, basic_frame
            module: c
            n_area = rect_area(3, 4)
            $print area = $n_area
            greet("World")

        fncode: rect_area(n_w, n_h)
            return n_w * n_h

        fncode: mean(a, b: double): double
            return (a+b)/2

        fncode: greet(s_name)
            $print Hello $s_name!
    &call codeprint, c
        int rect_area(int n_w, int n_h);
        void greet(char *s_name);
        ...
        int rect_area(int n_w, int n_h)
        {
            return n_w * n_h;
        }
    $p
        Parameters can be grouped with semicolons:
    &call codeprint, mydef
        fncode: A(c, f; int a1, a2; b1, b2: float)
    &call codeprint, c
        void A(unsigned char c, float f, int a1, int a2, float b1, float b2)
    $p
        $(code:c) and $(code:f) get their inferred types, a leading type ($(code:int a1)) or a trailing one ($(code:b2&#58; float)) applies to the whole group.
    $p
        As in $(code:output_perl), only functions that are actually called are included -- $(code:mean) above is left out. The detection is a simple scan of the code lines for $(code:name&#40;). It misses a function that is used without a direct call -- one passed as a callback or stored in a function pointer, for example. Add such functions explicitly with $(code:$list):
    &call codeprint, mydef
        $list rect_area, mean

    $call subsection, c_misc, Headers, macros, and structures
    $p
        $(code:$include) adds a header at the top of the file, with or without the $(code:.h): $(code:$include math) becomes $(code:&num;include &lt;math.h&gt;). What inferred types need is added automatically -- $(code:stdint.h) for $(code:int32_t) and friends, and a $(code:bool) typedef when a $(code:bool) variable is used. Plain C preprocessor lines -- $(code:&num;include), $(code:&num;define), $(code:&num;ifdef), and the rest -- are recognized and passed through, even though $(code:&num;) otherwise starts a $(code:MyDef) comment.
    $p
        $(code:$struct(Name) fields) declares a structure, with field types following the naming rules:
    &call codeprint, mydef
        $struct(point) f_x, f_y, s_label
        $local struct point pt
    &call codeprint, c
        struct point {
            float f_x;
            float f_y;
            char* s_label;
        };
    $p
        To link libraries, set $(code:lib_list) on the page. It is passed to the compiler as is:
    &call codeprint, mydef
        page: t, basic_frame
            module: c
            lib_list: -lm
            $include math
            $local double r = 2.0
            $print "sqrt = %f", sqrt(r)

    $call subsection, c_std, $(code:std_c.def) and the C library
    $p
        $(code:std_c.def) is loaded automatically for $(code:module: c). Besides $(code:basic_frame), it has small helpers such as $(code:$call assert&#44; cond), $(code:$call die&#44; msg), and $(code:$call warn&#44; msg). $(code:$allocate(n) pn_array) allocates an array with $(code:calloc) (with an optional initial value, $(code:$allocate(n&#44; 0) pn_array)), and records its size so $(code:$foreach pn_array) can loop over it.
    $p
        Larger pieces live in optional libraries under $(code:c/), pulled in with $(code:include:) -- for example $(code:include: c/string.def), $(code:c/hash.def), $(code:c/darray.def), $(code:c/regex.def), $(code:c/getopt.def), and $(code:c/thread.def). The $(code:tests/) folder of the $(code:output_c) repository has working examples of most features.
