subcode:: sections
    $call section, python, $(code:output_python)
    $p
        $(code:output_python) lives in its own repository, $(a:github.com/hzhou/output_python,https://github.com/hzhou/output_python), and is installed the same way as $(code:output_c) ($(code:mydef_make), $(code:make), $(code:make install)). It provides $(code:module: python), which writes Python 3.
    $p
        Python already has little syntax noise, so $(code:output_python) adds less than the other modules. What it does add is the shared $(code:MyDef) toolkit -- $(code:$print), $(code:$for), regex capture, and the file and $(code:import) bookkeeping -- in the same form as in $(code:output_perl) and $(code:output_c), so a program can move between them with few changes. Its companion script $(code:perl_to_python) converts a $(code:module: perl) page into a $(code:module: python) one.

    $call subsection, python_plain, It is OK to write vanilla Python
    $p
        A page with $(code:module: python) compiles to a $(code:.py) file. As with $(code:output_c), the page code goes into a $(code:main) function, from the default $(code:basic_frame) in $(code:std_python.def). A $(code:.def) file without a $(code:page:) line works too, as a page named after the file.
    &call codeprint, mydef
        page: t
            module: python

            n = 3
            if n > 2
                print("n is big")
            $if n > 5
                print "huge"
            $elif !n
                print "zero"
            $else
                n++
                $print n=$n, n*7=${n*7}
    &call codeprint, sh
        $ mydef_run t.def
        PAGE: t
          --> [./t.py]
        python ./t.py
        n is big
        n=4, n*7=28
    $p
        and $(code:t.py) is:
    &call codeprint, python
        def main():
            n = 3
            if n > 2:
                print("n is big")
            if n > 5:
                print("huge")
            elif not n:
                print("zero")
            else:
                n+=1
                print("n=%s, n*7=%s" % (n, n*7))

        &num; ---------------------------------------------------------
        if __name__ == "__main__":
            main()
    $p
        Plain Python passes through, as long as it is indented properly. On top of it:
    $ul
        $li
            The trailing colon after $(code:if), $(code:elif), $(code:else), $(code:while), $(code:for), and $(code:def) is optional.
        $li
            $(code:print x) becomes $(code:print(x)).
        $li
            $(code:n++) and $(code:n--) become $(code:n+=1) and $(code:n-=1).
        $li
            $(code:$if), $(code:$elif), $(code:$else), and $(code:$while) work as in the other modules, and $(code:!) in their condition becomes $(code:not).
        $li
            $(code:$while cond; step) puts $(code:step) at the end of the loop body.
    $p
        The comment rules of the Syntax chapter apply: a $(code:&num;) with spaces on both sides starts a $(code:MyDef) comment, even inside a string. Write $(code:"a &#92;x23 b") for such a string.

    $call subsection, python_print, $(code:$print)
    $p
        $(code:$print) is for debug printing. It fills in $(code:$var) and $(code:${expr}) and adds a newline, as in the other modules. A trailing $(code:-) leaves the newline out. $(code:$print) writes a $(code:%) format; since Python formats any value with $(code:%s), there is no type to infer. Related directives:
    &call codeprint, mydef
        $print n=$n, root=${sqrt(n)}
        $print no newline-
        $dump n, L
        $warn cannot open $fname
        $die bad input: $s
    &call codeprint, python
        print("n=%s, root=%s" % (n, sqrt(n)))
        print("no newline", end='')
        print("n = %s, L = %s" % (n, L))
        print("cannot open %s" % fname, file=sys.stderr)
        raise Exception("bad input: %s" % s)
    $p
        $(code:import sys) is added for $(code:$warn). When one value needs a specific format, quote the text and give the format arguments after it, as in $(code:output_c):
    &call codeprint, mydef
        $print "x = %.2f, n = $n", x
    &call codeprint, python
        print("x = %.2f, n = %s" % (x, n))
    $p
        Since a $(code:%) can start a format, write $(code:%%) for a literal percent sign: $(code:$print done: 100%%). (A lone $(code:%) followed by a space and a letter, as in $(code:50% done), is read as the printf format $(code:% d) and triggers a $(code:Missing 1 fmt arguments) warning.) When $(code:$print) gets in the way, write a plain $(code:print()) or an f-string.

    $call subsection, python_for, $(code:$for) and $(code:$do)
    $p
        $(code:$for) turns the usual loop forms into $(code:range)&#44; $(code:enumerate)&#44; and $(code:zip). $(code:$foreach) is the same as $(code:$for).
    $table ref
        $tr
            $th "MyDef"
            $th "Python"
        $tr
            $td
                $(code:$for i=0&#58;10)
            $td
                $(code:for i in range(10):)
        $tr
            $td
                $(code:$for i=2&#58;10)
            $td
                $(code:for i in range(2&#44;10):)
        $tr
            $td
                $(code:$for i=0&#58;10&#58;2)
            $td
                $(code:for i in range(0&#44;10&#44;2):)
        $tr
            $td
                $(code:$for N)
            $td
                $(code:for _i in range(N):)
        $tr
            $td
                $(code:$for x in L)
            $td
                $(code:for x in L:)
        $tr
            $td
                $(code:$for i&#44; x in L)
            $td
                $(code:for i&#44; x in enumerate(L):)
        $tr
            $td
                $(code:$for x&#44; y in A&#44; B)
            $td
                $(code:for x&#44; y in zip(A&#44; B):)
        $tr
            $td
                $(code:$for i&#44; a&#44; b in A&#44; B)
            $td
                $(code:for i&#44; a&#44; b in zip(range(len(A))&#44; A&#44; B):)
    $p
        With two variables and one list, $(code:$for) uses $(code:enumerate) when the first variable is named $(code:i) through $(code:n); with as many lists as variables, it uses $(code:zip).
    $p
        $(code:$do) makes a block that runs once, which you can leave early with $(code:break):
    &call codeprint, mydef
        $do
            $if not ready
                break
            process()
    &call codeprint, python
        while 1: &num; $do:
            if not ready:
                break
            process()
            break

    $call subsection, python_fn, Functions, $(code:$global), and $(code:$import)
    $p
        $(code:fncode:) defines a module-level function, written after $(code:main) in the order they are first called. As with $(code:output_c), a function is included only when the code calls it; unused ones are left out. A $(code:def) inside the page code is an ordinary nested function.
    &call codeprint, mydef
        page: t
            module: python

            $import sqrt from math
            $global count = 0
            bump()
            bump()
            $print count = $count, root = ${sqrt(add(7, 9))}

        fncode: add(a, b)
            return a + b

        fncode: bump
            $global count
            count += 1

        fncode: unused
            pass
    &call codeprint, python
        from math import sqrt

        count = 0

        def main():
            global count
            bump()
            bump()
            print("count = %s, root = %s" % (count, sqrt(add(7, 9))))

        &num; ---- subroutines --------------------------------------------
        def bump():
            global count
            count += 1

        def add(a, b):
            return a + b
    $p
        $(code:$global count = 0) puts the assignment at module level and $(code:global count) in the current function. Other functions that assign to it need their own $(code:$global count).
    $p
        $(code:$import) lines can appear anywhere; they are collected at the top of the file, with duplicates removed. $(code:$import numpy as np) and $(code:$import sqrt from math) (for $(code:from math import sqrt)) are both accepted. $(code:$try_import yaml) wraps the import in $(code:try) and sets $(code:has_yaml) to $(code:True) or $(code:False). Modules used as $(code:re.)&#44; $(code:os.)&#44; $(code:sys.)&#44; $(code:copy.)&#44; or $(code:glob.) are imported automatically.

    $call subsection, python_capture, Regex capture with $(code:->)
    $p
        The Perl-style match and capture from $(code:output_perl) (see its section on regex capture) works in $(code:$if) and $(code:$elif), and becomes $(code:re.search):
    &call codeprint, mydef
        $if s=~/Hello\s+(\w+)/ -> who
            $print Match: $who
    &call codeprint, python
        if re.search(r'Hello\s+(\w+)', s):
            m = re.search(r'Hello\s+(\w+)', s)
            who = m.group(1)
            print("Match: %s" % who)
    $p
        A pattern anchored with $(code:^) becomes $(code:re.match). For a lexer, $(code:$if_match pattern) matches at position $(code:src_pos) in $(code:src), precompiles the pattern, and on success advances $(code:src_pos) and leaves the match in $(code:m).

    $call subsection, python_std, $(code:std_python.def)
    $p
        $(code:std_python.def) is loaded automatically. Its file subcodes take the file name as a Python expression, so a literal name needs quotes:
    &call codeprint, mydef
        &call open_W, "words.txt"
            $print apple pie
            $print banana split
            $print apple tart
        counts = {}
        &call open_r, "words.txt"
            $if line=~/^(\w+)/ -> fruit
                $call dict_inc, counts, fruit
        $for k in sorted(counts)
            $print $k: ${counts[k]}
    &call codeprint, sh
        $ mydef_run t.def
        ...
          --> [words.txt]
        apple: 2
        banana: 1
    $table ref
        $tr
            $th "Subcode"
            $th "Does"
        $tr
            $td
                $(code:&call open_r&#44; fname)
            $td
                loops over the lines of a file&#44; each in $(code:line)
        $tr
            $td
                $(code:&call open_w&#44; fname)
            $td
                opens a file for writing as $(code:Out)
        $tr
            $td
                $(code:&call open_W&#44; fname)
            $td
                same as $(code:open_w)&#44; but also prints $(code:--> [fname]) and sends $(code:$print) to the file
        $tr
            $td
                $(code:$call dict_inc&#44; D&#44; key)
            $td
                counts $(code:key) in dictionary $(code:D)
        $tr
            $td
                $(code:&dollar;(ternary:cond&#44; a&#44; b))
            $td
                $(code:a if cond else b)
        $tr
            $td
                $(code:$call start_time) / $(code:$call print_time&#44; msg)
            $td "time a section of code"
    $p
        Two optional libraries can be loaded with an $(code:include:) line: $(code:python/parse.def) for writing parsers, and $(code:python/tkinter.def) for Tk GUIs.
